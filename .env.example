# ─── GitHub Credentials ──────────────────────────────────────────────────────
# Used in env mode only (single shared credentials loaded from environment).
# Not required when AUTH_MODE=gateway (credentials are provided per-request via headers).
# GITHUB_TOKEN is a GitHub OAuth access token (the OAuth flow is handled upstream).
GITHUB_TOKEN=your_oauth_access_token
GITHUB_ORG=your_org_slug

# Base URL of the GitHub REST API (change for GitHub Enterprise Server).
GITHUB_BASE_URL=https://api.github.com

# HTTP header names that carry the per-request credentials in gateway mode.
# The client must send BOTH headers on every /mcp request.
GITHUB_TOKEN_HEADER=X-GitHub-Token
GITHUB_ORG_HEADER=X-GitHub-Org

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) credentials provided per-request via the
#             GITHUB_TOKEN_HEADER and GITHUB_ORG_HEADER HTTP headers.
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
# "env"     — (local dev only) single token + org loaded from GITHUB_TOKEN / GITHUB_ORG.
#             NOT SOP-compliant: credentials are shared across all requests; do not use in production.
AUTH_MODE=gateway
